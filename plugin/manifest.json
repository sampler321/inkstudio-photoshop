{
  "manifestVersion": 5,
  "id": "inkstudio.photoshop",
  "name": "InkStudio",
  "version": "0.1.7",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "allowCodeGenerationFromStrings": false
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "library",
      "label": {
        "default": "InkStudio Brushes"
      },
      "minimumSize": {
        "width": 260,
        "height": 400
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 700
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 820
      },
      "maximumSize": {
        "width": 1200,
        "height": 3000
      }
    },
    {
      "type": "panel",
      "id": "rail",
      "label": {
        "default": "InkStudio Rail"
      },
      "minimumSize": {
        "width": 64,
        "height": 660
      },
      "preferredDockedSize": {
        "width": 72,
        "height": 600
      },
      "preferredFloatingSize": {
        "width": 72,
        "height": 680
      },
      "maximumSize": {
        "width": 1200,
        "height": 3000
      }
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "generic"
      ]
    }
  ]
}