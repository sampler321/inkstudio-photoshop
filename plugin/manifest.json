{
  "manifestVersion": 5,
  "id": "inkstudio.photoshop",
  "name": "InkStudio",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "24.0.0" },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "allowCodeGenerationFromStrings": false
  },
  "entrypoints": [
    { "type": "panel", "id": "library", "label": { "default": "InkStudio Brushes" },
      "minimumSize": { "width": 220, "height": 300 }, "preferredDockedSize": { "width": 300, "height": 700 },
      "preferredFloatingSize": { "width": 320, "height": 720 } },
    { "type": "panel", "id": "rail", "label": { "default": "InkStudio Rail" },
      "minimumSize": { "width": 64, "height": 300 }, "preferredDockedSize": { "width": 72, "height": 600 },
      "preferredFloatingSize": { "width": 72, "height": 600 } }
  ],
  "icons": [ { "width": 23, "height": 23, "path": "icons/icon.png", "scale": [1, 2], "theme": ["all"], "species": ["generic"] } ]
}
